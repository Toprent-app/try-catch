{
  "name": "@power-rent/try-catch",
  "version": "2.0.1",
  "description": "A TypeScript utility for simplified async error handling with Sentry integration",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/esm/nextjs/index.d.ts",
        "default": "./dist/esm/nextjs/index.js"
      },
      "require": {
        "types": "./dist/nextjs/index.d.ts",
        "default": "./dist/nextjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser/index.d.ts",
        "default": "./dist/esm/browser/index.js"
      },
      "require": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/nextjs/index.js",
    "./dist/esm/nextjs/index.js",
    "./dist/node/index.js",
    "./dist/esm/node/index.js",
    "./dist/browser/index.js",
    "./dist/esm/browser/index.js"
  ],
  "scripts": {
    "build": "npm run typecheck && tsup --config tsup.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.build.json",
    "build:watch": "tsup --config tsup.config.ts --watch",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "check:package": "node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples",
    "lint": "eslint 'src/**/*.ts'",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:examples && npm run test && npm run build && npm run check:package",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "typescript",
    "error-handling",
    "async",
    "sentry",
    "try-catch",
    "error-reporting"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toprent-app/try-catch.git"
  },
  "bugs": {
    "url": "https://github.com/Toprent-app/try-catch/issues"
  },
  "homepage": "https://github.com/Toprent-app/try-catch#readme",
  "peerDependencies": {
    "@sentry/browser": ">=8.0.0 <11.0.0",
    "@sentry/nextjs": ">=8.0.0 <11.0.0",
    "@sentry/node": ">=8.0.0 <11.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/nextjs": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "@sentry/browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@sentry/browser": ">=8.0.0 <11.0.0",
    "@sentry/nextjs": ">=8.0.0 <11.0.0",
    "@sentry/node": ">=8.0.0 <11.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "type-fest": "^5.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(src/**/*).{ts,tsx}": [
      "prettier --write"
    ],
    "*.{js,jsx,json}": [
      "prettier --write"
    ]
  },
  "typesVersions": {
    "*": {
      "nextjs": [
        "dist/nextjs/index.d.ts"
      ],
      "node": [
        "dist/node/index.d.ts"
      ],
      "browser": [
        "dist/browser/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
